FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
COPY requirements-llm.txt ./requirements-llm.txt
RUN pip install --upgrade pip \
    && pip install -r requirements.txt \
    && pip install -r requirements-llm.txt

COPY app ./app
COPY tests ./tests
COPY scripts/start_gpu_server.sh ./scripts/start_gpu_server.sh
RUN mkdir -p ./checkpoints ./data \
    && chmod +x ./scripts/start_gpu_server.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1

CMD ["/app/scripts/start_gpu_server.sh"]
